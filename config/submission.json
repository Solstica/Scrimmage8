{
  "entry_tex": "paper/main.tex",
  "staging_dir": "submission",
  "zip_name": "submission.zip",
  "compile": true,
  "latexmk": "latexmk",
  "include_final_pdf": true,
  "final_pdf_name": "final.pdf",
  "include_module_code": true,
  "include_root_requirements": true,
  "target_zip_mb": 18.0,
  "hard_zip_mb": 20.0,
  "warn_vector_mb": 0.5,
  "warn_raster_mb": 1.0,
  "extra_include": [],
  "exclude": [
    ".git/**",
    ".github/**",
    "docs/**",
    "work/**",
    "output/**",
    "submission/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.ipynb_checkpoints/**",
    "**/.venv/**",
    "**/venv/**",
    "**/*.tmp",
    "**/~$*"
  ]
}
